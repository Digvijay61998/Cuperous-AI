      "label": "Delivery Fee",
      "defaultValue": 0,
      "group": "Pricing"
    },
    {
      "key": "tax_rate",
      "type": "number",
      "label": "Tax Rate (decimal)",
      "defaultValue": 0,
      "group": "Pricing"
    },
    {
      "key": "estimated_delivery_time",
      "type": "text",
      "label": "Estimated Delivery Time",
      "defaultValue": "1 within Hour",
      "group": "Delivery"
    },
    {
      "key": "currency",
      "type": "text",
      "label": "Currency Code",
