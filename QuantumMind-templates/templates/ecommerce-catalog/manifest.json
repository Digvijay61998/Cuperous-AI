    },
    {
      "key": "accent_color",
      "type": "color",
      "label": "Accent Color",
      "defaultValue": "#F83758",
      "group": "Theme"
    },
    {
      "key": "text_color",
      "type": "color",
      "label": "Text Color",
      "defaultValue": "#000000",
      "group": "Theme"
    },
    {
      "key": "background_color",
      "type": "color",
      "label": "Background Color",
      "defaultValue": "#FFFFFF",
      "group": "Theme"
    },
    {
      "key": "font_family",
      "type": "text",
      "label": "Font Family",
      "defaultValue": "system-ui, -apple-system, sans-serif",
      "group": "Theme"
    },
    {
