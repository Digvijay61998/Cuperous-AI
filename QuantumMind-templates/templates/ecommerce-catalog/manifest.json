{
  "name": "eCommerce Catalog",
  "description": "A configurable 5-step eCommerce product catalog for WhatsApp WebView with product browsing, detail view, cart, and checkout. Light theme with pink accent.",
  "industry": "ecommerce",
  "category": "ordering",
  "tags": ["ecommerce", "catalog", "shopping", "products"],
  "supportedLanguages": ["en"],
  "supportsDarkMode": true,
  "estimatedDuration": "3 minutes",
  "templateConfig": [
    {
      "key": "brand_name",
      "type": "text",
      "label": "Brand Name",
      "defaultValue": "Stylish",
      "group": "Branding"
    },
    {
      "key": "brand_logo",
      "type": "image",
      "label": "Brand Logo",
      "defaultValue": "",
      "group": "Branding"
    },
    {
      "key": "hero_image",
      "type": "image",
      "label": "Hero Background Image",
      "defaultValue": "",
      "group": "Branding"
    },
    {
      "key": "tagline",
      "type": "text",
      "label": "Tagline",
      "defaultValue": "You want Authentic, here you go!",
      "group": "Branding"
    },
    {
      "key": "subtitle",
      "type": "text",
      "label": "Subtitle",
      "defaultValue": "Find it here, buy it now!",
      "group": "Branding"
    },
    {
      "key": "primary_color",
      "type": "color",
