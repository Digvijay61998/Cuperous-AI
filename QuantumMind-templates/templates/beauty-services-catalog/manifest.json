{
  "name": "Beauty Services Catalog",
  "description": "A modern, animated 5-step booking flow for beauty services with category-first browsing, circular icon grids, card-based service selection, and smooth CSS transitions. Optimised for WhatsApp WebView.",
  "industry": "beauty",
  "category": "appointment",
  "tags": ["beauty", "services", "booking", "catalog"],
  "supportedLanguages": ["en"],
  "supportsDarkMode": true,
  "estimatedDuration": "2 minutes",
  "templateConfig": [
    {
      "key": "business_name",
      "type": "text",
      "label": "Business Name",
      "defaultValue": "Glow Beauty Studio",
      "group": "Branding"
    },
    {
      "key": "business_logo",
      "type": "image",
      "label": "Business Logo",
      "defaultValue": "",
      "group": "Branding"
    },
    {
      "key": "hero_image",
      "type": "image",
      "label": "Hero Background Image",
      "defaultValue": "",
      "group": "Branding"
    },
    {
      "key": "hero_title",
      "type": "text",
      "label": "Hero Title",
      "defaultValue": "Book Your Beauty Experience",
      "group": "Branding"
    },
    {
      "key": "hero_subtitle",
      "type": "text",
      "label": "Hero Subtitle",
      "defaultValue": "Choose from our premium beauty services and book your appointment in minutes.",
      "group": "Branding"
    },
    {
      "key": "primary_color",
      "type": "color",
      "label": "Primary Color",
      "defaultValue": "#E91E63",
      "group": "Theme"
    },
    {
      "key": "secondary_color",
      "type": "color",
      "label": "Secondary Color",
      "defaultValue": "#9C27B0",
      "group": "Theme"
    },
    {
      "key": "accent_color",
      "type": "color",
      "label": "Accent Color",
      "defaultValue": "#FF5722",
      "group": "Theme"
    },
    {
      "key": "text_color",
      "type": "color",
      "label": "Text Color",
      "defaultValue": "#1A1A2E",
      "group": "Theme"
    },
    {
      "key": "background_color",
      "type": "color",
      "label": "Background Color",
      "defaultValue": "#FAFAFA",
      "group": "Theme"
    },
    {
      "key": "font_family",
      "type": "text",
      "label": "Font Family",
      "defaultValue": "system-ui, -apple-system, sans-serif",
      "group": "Theme"
    },
    {
      "key": "dark_mode",
      "type": "boolean",
      "label": "Enable Dark Mode",
      "defaultValue": false,
      "group": "Theme"
    },
    {
