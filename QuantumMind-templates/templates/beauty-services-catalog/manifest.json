      "group": "Scheduling"
    },
    {
      "key": "time_slot_interval",
      "type": "number",
      "label": "Time Slot Interval (minutes)",
      "defaultValue": 30,
      "group": "Scheduling"
    },
    {
      "key": "advance_booking_days",
      "type": "number",
      "label": "Advance Booking Days",
