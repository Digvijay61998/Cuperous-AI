{
  "name": "Meeting Scheduler",
  "description": "Configurable, mobile-first Calendly-style meeting booking flow for scheduling demos, consultations, and calls. Optimised for WhatsApp WebView.",
  "industry": "general",
  "category": "scheduling",
  "tags": ["meeting", "scheduling", "demo", "booking", "calendar"],
  "supportedLanguages": ["en"],
  "supportsDarkMode": true,
  "estimatedDuration": "1 minute",
  "templateConfig": [
    {
      "key": "business_name",
      "type": "text",
      "label": "Business Name",
      "defaultValue": "Acme Inc.",
      "group": "Branding"
    },
    {
      "key": "business_logo",
      "type": "image",
      "label": "Business Logo",
      "defaultValue": "",
      "group": "Branding"
    },
    {
      "key": "meeting_title",
      "type": "text",
      "label": "Meeting Title",
      "defaultValue": "Book a Meeting",
      "group": "Branding"
    },
    {
      "key": "meeting_subtitle",
      "type": "text",
      "label": "Meeting Subtitle",
      "defaultValue": "Pick a date and time that works for you.",
      "group": "Branding"
    },
    {
      "key": "meeting_description",
      "type": "text",
      "label": "Meeting Description",
      "defaultValue": "Schedule a 30-minute meeting to discuss your needs. We'll send you a confirmation email with all the details.",
      "group": "Branding"
    },
    {
      "key": "meeting_duration",
      "type": "number",
      "label": "Meeting Duration (minutes)",
      "defaultValue": 30,
      "group": "Scheduling"
    },
    {
      "key": "primary_color",
      "type": "color",
      "label": "Primary Color",
      "defaultValue": "#0060E6",
      "group": "Theme"
    },
    {
      "key": "text_color",
      "type": "color",
      "label": "Text Color",
      "defaultValue": "#1A1D29",
      "group": "Theme"
    },
    {
      "key": "background_color",
      "type": "color",
      "label": "Background Color",
      "defaultValue": "#FFFFFF",
      "group": "Theme"
    },
    {
      "key": "font_family",
      "type": "text",
      "label": "Font Family",
      "defaultValue": "Inter",
      "group": "Theme"
    },
    {
      "key": "dark_mode",
      "type": "boolean",
      "label": "Enable Dark Mode",
      "defaultValue": false,
      "group": "Theme"
    },
    {
      "key": "working_hours",
      "type": "json",
      "label": "Working Hours",
      "defaultValue": {
        "monday": { "open": "09:00", "close": "17:00" },
        "tuesday": { "open": "09:00", "close": "17:00" },
        "wednesday": { "open": "09:00", "close": "17:00" },
        "thursday": { "open": "09:00", "close": "17:00" },
        "friday": { "open": "09:00", "close": "17:00" },
        "saturday": null,
        "sunday": null
      },
      "group": "Scheduling"
    },
    {
      "key": "slot_duration",
      "type": "number",
      "label": "Slot Duration (minutes)",
      "defaultValue": 30,
      "group": "Scheduling"
    },
    {
      "key": "advance_booking_days",
      "type": "number",
      "label": "Advance Booking Days",
      "defaultValue": 30,
      "group": "Scheduling"
    },
    {
      "key": "success_message",
      "type": "text",
      "label": "Success Message",
      "defaultValue": "Your meeting has been scheduled!",
      "group": "Content"
    },
    {
      "key": "auto_close_delay",
      "type": "number",
      "label": "Auto Close Delay (seconds)",
      "defaultValue": 3,
      "group": "Content"
    },
    {
      "key": "show_phone_field",
      "type": "boolean",
      "label": "Show Phone Field",
      "defaultValue": true,
      "group": "Form"
    },
    {
      "key": "labels",
      "type": "json",
      "label": "UI Labels",
      "defaultValue": {
        "confirm_heading": "Confirm Your Booking",
        "name_label": "Name",
        "name_placeholder": "Enter your name",
        "email_label": "Email",
        "email_placeholder": "Enter your email",
        "phone_label": "Phone (optional)",
        "phone_placeholder": "Enter your phone number",
        "confirm_button": "Confirm Booking",
        "back": "Back",
        "next": "Next",
        "no_availability": "No available times for this date",
        "booking_error": "Booking could not be completed. Please try again.",
        "close_instruction": "You may close this window"
      },
      "group": "Content"
    }
  ]
}
