{
  "name": "jarcube-templates",
  "version": "0.1.0",
  "private": true,
  "description": "JarCube interactive WhatsApp WebView templates monorepo",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "new:template": "plop --plopfile tooling/plopfile.cjs template",
    "build:template": "tsx tooling/build-and-zip.ts",
    "upload:template": "tsx tooling/upload.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-react": "^4.3.1",
    "adm-zip": "^0.5.16",
    "plop": "^4.0.1",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=18"
  }
}
