:root {
  --qt-primary: #2241ff;
  --qt-bg: #ffffff;
  --qt-text: #1a1a1a;
}
* { box-sizing: border-box; }
html, body, #root { margin: 0; height: 100%; }
body {
  font-family: var(--qt-font, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
  background: var(--qt-bg);
  color: var(--qt-text);
}
.screen {
  max-width: 480px;
  margin: 0 auto;
  padding: 24px 20px;
}
