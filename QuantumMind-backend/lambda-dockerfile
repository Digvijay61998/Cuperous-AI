FROM --platform=linux/amd64 public.ecr.aws/lambda/nodejs:18 AS builder

ENV NODE_ENV build
WORKDIR /var/task

COPY package.json package-lock.json ./

COPY . .

RUN npm install && npm cache clean --force
RUN npm run build

FROM --platform=linux/amd64 public.ecr.aws/lambda/nodejs:18

ENV NODE_ENV production

WORKDIR /var/task

COPY --from=builder  /var/task/package*.json ./
COPY --from=builder  /var/task/node_modules/ ./node_modules/
COPY --from=builder /var/task/dist/ ./dist/

CMD ["dist/lambda.handler"]


